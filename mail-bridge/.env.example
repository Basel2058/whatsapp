# ---- Mailbox the terminal sends to (create a dedicated one, e.g. whatsapp@company.com)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=whatsapp@company.com
IMAP_PASSWORD=app-password-here
IMAP_FOLDER=INBOX
POLL_SECONDS=30

# Only these senders are forwarded. Full addresses or whole domains (@company.com), comma separated.
ALLOWED_SENDERS=@company.com

# Numbers starting with 0 get this country code (050... -> 97250...)
DEFAULT_COUNTRY_CODE=972

# ---- WhatsApp Cloud API (developers.facebook.com -> your app -> WhatsApp -> API Setup)
WA_TOKEN=permanent-system-user-token
WA_PHONE_NUMBER_ID=123456789012345
WA_API_VERSION=v23.0

# Approved template with a DOCUMENT header (see README)
WA_DOC_TEMPLATE=document_send
# Optional: approved text template, used for emails with no attachment
WA_TEXT_TEMPLATE=
WA_TEMPLATE_LANG=he
# How many {{n}} variables the templates' body has (0 or 1). {{1}} = the subject text after the number.
WA_TEMPLATE_PARAMS=1

# ---- Optional: email the result back to the sender (errors | all | none)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# SMTP_USER / SMTP_PASSWORD default to the IMAP ones
NOTIFY_SENDER=errors

# ---- Optional: email customer replies and failed deliveries to you (needs SMTP above)
# Leave WA_VERIFY_TOKEN empty to turn this off.
FORWARD_TO=office@company.com
# Any random text; type the same text in Meta's webhook settings
WA_VERIFY_TOKEN=
# App dashboard -> App settings -> Basic -> App secret
WA_APP_SECRET=
WEBHOOK_PORT=8080
# Public name of the server for HTTPS. No domain? Use your server IP with dashes + .sslip.io
DOMAIN=203-0-113-5.sslip.io
